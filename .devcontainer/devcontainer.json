{
  "name": "n8n",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [5678],

  "containerEnv": {
    "N8N_USER_FOLDER": "${containerWorkspaceFolder}/.n8n-data"
  },

  "updateContentCommand": "bash .devcontainer/updateContent.sh",
  "postStartCommand": "N8N_HOST=$CODESPACE_NAME-5678.app.github.dev N8N_PROTOCOL=https N8N_EDITOR_BASE_URL=https://$CODESPACE_NAME-5678.app.github.dev WEBHOOK_URL=https://$CODESPACE_NAME-5678.app.github.dev/ N8N_PROXY_HOPS=1 n8n start"
}
