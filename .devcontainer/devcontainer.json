{
  "name": "n8n",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [5678],

  "containerEnv": {
    "N8N_USER_FOLDER": "${containerWorkspaceFolder}/.n8n-data"
  },

  "updateContentCommand": "bash .devcontainer/updateContent.sh",
  "postStartCommand": "n8n start"
}
